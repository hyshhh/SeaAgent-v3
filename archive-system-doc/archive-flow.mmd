%% 档案库管理系统 业务流程（Mermaid 版，与 archive-flow.png 内容一致）
%% 渲染：mermaid-cli（mmdc -i archive-flow.mmd -o archive-flow-mermaid.svg）
flowchart TB
    Start(["用户 / 管理员 访问入口<br/>浏览器 · 内网 B/S · 自助终端"])

    subgraph L1["读者 / 利用者（档案查询 · 借阅利用）"]
        direction TB
        R1["注册 / 登录<br/>账号密码，或校内统一身份认证"]
        R2{"身份与权限校验"}
        R2a["提示错误，累计失败 3 次锁定账号"]
        R3["进入档案门户<br/>本馆概况 · 新入藏 · 通知公告 · 办事指南"]
        R4["目录浏览<br/>全宗—目录—案卷—文件 四级"]
        R5["多条件检索<br/>题名 / 责任者 / 时间 / 主题词 / 档号 / 全文"]
        R6["检索结果列表<br/>题名 · 时间 · 保管期限 · 状态"]
        R7["案卷详情与全文预览<br/>元数据 + 影像 + 开放程度说明"]
        R8{"权限判定"}
        R9["阅览 / 下载<br/>在线阅览 · 打印 · 受控下载"]
        R10["提交借阅申请<br/>填写用途与借期"]
        R11["借出登记<br/>登记借阅人与归还期限，生成凭证"]
        R12["到期提醒<br/>到期前 3 天提醒；逾期暂停借阅权限"]
        R13["归还 / 破损处理<br/>核验完整性，放回库位；破损登记异常"]
        R14["退出系统<br/>会话销毁 · 超时自动登出"]
    end

    subgraph L2["档案管理员（收集 · 整理 · 保管 · 利用）"]
        direction TB
        C1["登录后台管理系统<br/>档案员账号，功能按角色授权"]
        C2{"归类分流"}
        C3["著录与标引<br/>档号 · 题名 · 责任者 · 时间 · 期限 · 密级"]
        C4["OCR / 全文提取<br/>生成全文文本与检索索引"]
        C5["著录校验与查重<br/>档号唯一性 · 字段规范 · 重复件"]
        C6["实体上架与数字化归档<br/>库位号登记 / 服务器双副本"]
        C7["库位索引<br/>档号 ↔ 库位 / RFID / 条码"]
        C8["档案调取<br/>按档号或扫码出库，核对库位"]
        C9{"借阅审批"}
        C10["归还核验与续借<br/>核对份数与完整性"]
        C11{"到期鉴定"}
        C12["鉴定与销毁<br/>鉴定小组复审 · 报批后监销 · 登记清册"]
        C13["退出系统<br/>登出并保留操作日志"]
    end

    subgraph L3["系统与管理层（权限 · 安全 · 备份 · 统计）"]
        direction TB
        S1["系统自动运行<br/>逾期提醒 · 库房盘点 · 日志归档 · 统计报表"]
        S2["用户 / 角色 / 权限维护<br/>账号管理 · 角色授权 · 密级分级管控"]
        S3["审计日志<br/>操作 / 访问 / 借阅行为追溯，防篡改留存"]
        S4["数据备份与恢复<br/>全量 + 增量 · 异地异质保存 · 恢复演练"]
    end

    Start --> R1
    Start --> C1
    Start --> S1

    R1 --> R2
    R2 -- 否 --> R2a --> R1
    R2 -- 是 --> R3 --> R4 --> R5 --> R6 --> R7 --> R8
    R8 -- 开放档案：在线阅读 --> R9
    R8 -- 控制 / 涉密：需审批留痕 --> R9
    R9 -- 需离线利用 --> R10
    R9 --> R14
    R10 -. 提交借阅申请 .-> C9
    R10 --> R11 --> R12 --> R13
    R13 --> R14

    C1 --> C2
    C2 -- 新收档案 --> C3 --> C4 --> C5 --> C6 --> C7
    C2 -- 借阅申请 --> C9
    C7 --> C8 --> C9
    C9 -- 一般档案：档案员审批 --> C10
    C9 -- 重要 / 控制档案：报主管领导 --> C10
    C10 --> C11
    C11 -- 已达保管期限 --> C12 --> C13
    C11 -- 未到期 --> C13
    C12 -. 销毁清册 / 鉴定记录归档 .-> S3

    R6 -. 检索命中为空：建议扩大范围或模糊检索 .-> R5
    C8 -. 库位不符：报异常并核对 .-> C7
    R2 -. 身份信息 .-> S2
    S1 -. 到期提醒推送 .-> R12

    classDef reader fill:#e7f0fa,stroke:#5b8ac6,color:#12324f
    classDef clerk fill:#e8f4ea,stroke:#5c9d70,color:#12324f
    classDef sys fill:#efe9f7,stroke:#9179bb,color:#12324f
    classDef dec fill:#fdf3df,stroke:#c1783a,color:#7a4a15
    classDef term fill:#f2f6fb,stroke:#3f6fb5,color:#1c3f66
    class R1,R3,R4,R5,R6,R7,R9,R10,R11,R12,R13 reader
    class R2a,R14 term
    class C1,C3,C4,C5,C6,C7,C8,C10,C12 clerk
    class C13 term
    class S1,S2,S3,S4 sys
    class R2,R8,C2,C9,C11 dec